// Phatica.ai — Prisma schema (PostgreSQL, Neon)
// Set DATABASE_URL in .env.local / Vercel env vars.
// Migrasi: repo ini sekarang memakai Prisma Migrate — buat tabel dengan
// `prisma migrate deploy` (Vercel Build Command).
// Database live yang dulu dibuat via `prisma db push` harus di-baseline SEKALI
// dengan `prisma migrate resolve --applied <timestamp>_init` sebelum
// migrate deploy pertama (lihat README). Jangan pakai migrate deploy
// tanpa baseline di database lama — tabel yang sudah ada akan ditolak.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth email + password (scrypt hash, sesi server custom 30 hari) ---
// Tidak ada provider login pihak ketiga, tidak ada kredensial OAuth,
// tidak ada setup login eksternal.
model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  passwordHash        String
  profile             LearnerProfile?
  memory              LearnerMemory?
  brandProfile        BrandProfile?
  practice            PracticeSession[]
  customRoleplays     CustomRoleplay[]
  customPillars       CustomPillar[]
  customScenarios     CustomScenario[]
  diagnostics         Diagnostic[]
  drills              Drill[]
  brandAudits         BrandAudit[]
  contentReviews      ContentReview[]
  subscription        Subscription?
  sessions            Session[]
  llmUsage            LlmUsage[]
  ttsUsage            TtsUsage[]
  passwordResetTokens PasswordResetToken[]
  feedbacks           Feedback[]
  createdAt           DateTime             @default(now())
}

// --- Sesi login (token acak, disimpan sebagai hash SHA-256) ---
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// --- Phatica ---
model LearnerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LearnerMemory {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  styleTraits    String   @default("") // dipisah koma
  strengths      String   @default("")
  weaknesses     String   @default("") // format: "kelemahan (n×)" dipisah |
  weaknessCounts String   @default("{}") // JSON {label: count}
  lastRecap      String   @default("") @db.Text
  lastScenario   String   @default("")
  totalSessions  Int      @default(0)
  totalTurns     Int      @default(0)
  levels         String   @default("{}") // JSON {pillar: level 1-5}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PracticeSession {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId       String? // null untuk Roleplay Bebas (skenario buatan pengguna)
  customRoleplayId String?
  customRoleplay   CustomRoleplay?   @relation(fields: [customRoleplayId], references: [id], onDelete: Cascade)
  customScenarioId String?
  customScenario   CustomScenario?   @relation(fields: [customScenarioId], references: [id], onDelete: SetNull)
  openingVariant   Int               @default(0) // skenario tetap: 0 = kalimat pembuka asli, 1..n = varian pembuka; Roleplay Bebas: 0
  pillar           String
  level            Int               @default(3)
  status           String            @default("active") // active | finished
  register         String            @default("santai") // formal | santai — pilihan pengguna sebelum sesi
  voiceMetrics     String            @default("") @db.Text // JSON [{turn, durationSec, words, paceWpm, fillers, used}] — metrik dari transkripsi browser, bukan analisis audio
  messages         SessionMessage[]
  adaptations      AdaptationEvent[]
  evaluation       Evaluation?
  feedbacks        Feedback[]
  drills           Drill[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// --- Tes Awal + Jalur Belajar ---
// Diagnostic: hasil Tes Awal (3 situasi singkat). scores + path disimpan JSON.
// Satu baris per Tes Awal; Tes Ulang membuat baris baru (yang terbaru yang dipakai).
model Diagnostic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores    String // JSON [{key: "bukti"|"struktur"|"empati"|"ketegasan", label, score}]
  weakest   String // JSON string[] — 2 dimensi terlemah
  path      String // JSON [{scenarioId, title, dimension, done}] — jalur belajar berurutan
  createdAt DateTime @default(now())
}

// --- Latihan Lanjutan (Drill 2 menit) ---
// Dibuat otomatis dari setiap evaluasi. dueAt = besok; pengguna mengerjakan
// di kartu "Latihan Hari Ini" di Beranda (in-app saja — belum ada pengingat email).
model Drill {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text      String          @db.Text // isi latihan 2 menit dari evaluasi
  blindSpot String          @default("") @db.Text
  status    String          @default("pending") // pending | done
  attempt   String          @default("") @db.Text // jawaban latihan pengguna
  dueAt     DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// --- Skenarioku / Pilarku — perpustakaan latihan milik pengguna ---
// Pilar buatan pengguna (maks 5 per akun) dan skenario buatan pengguna yang
// tersimpan (maks 20 per akun). Skenario menunjuk pilar lewat pillarKey:
// slug pilar bawaan ("interpersonal" | "pr-krisis" | "marketing-sales" |
// "personal-branding") atau "custom:<pillarId>".
// Skenario privat per akun; menghapus pilar TIDAK menghapus skenarionya
// (skenario dipindah ke pilar bawaan pilihan pengguna di API).
// Menghapus skenario TIDAK menghapus riwayat sesi — PracticeSession.
// customScenarioId di-set null (onDelete SetNull).
model CustomPillar {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // 2–40 karakter, unik per pengguna
  description String   @default("") // maks 200 karakter, opsional
  color       String // hex dari palet tetap (lihat src/lib/custom-library.ts)
  icon        String // nama dari daftar tetap (mis. "chat", "target")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
}

model CustomScenario {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillarKey              String // slug pilar bawaan atau "custom:<pillarId>"
  title                  String // 3–80 karakter
  personaName            String
  personaRole            String
  trait                  String // Skeptis | Marah | Ragu-ragu | Dingin | Menekan
  situation              String            @db.Text // min ~20 karakter
  goal                   String            @db.Text // wajib
  level                  Int               @default(3) // 1–5
  openingLine            String            @default("") @db.Text // kosong = dibuat otomatis dari situasi
  rubric                 String            @db.Text // JSON [{key,label,rubric,weight}] — 2–4 dimensi
  sourceScenarioId       String? // id skenario bawaan asal, bila dari duplikasi
  sourceCustomRoleplayId String? // id CustomRoleplay asal, bila dari "Simpan sebagai skenario"
  playCount              Int               @default(0)
  sessions               PracticeSession[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

// --- Roleplay Bebas / Skenario Buatanmu ---
// Skenario yang dibuat pengguna sendiri: persona + situasi + tujuan.
// personaCard dan rubric disimpan sebagai JSON hasil build server
// (lihat src/lib/custom-roleplay.ts). Dihapus bersama akun (Cascade)
// dan bersama riwayat lewat DELETE /api/history.
model CustomRoleplay {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaName      String
  personaRole      String
  trait            String // Skeptis | Marah | Ragu-ragu | Dingin | Menekan
  situation        String            @db.Text
  goal             String            @db.Text
  level            Int               @default(3)
  personaCard      String            @db.Text // JSON {personaName, personaRole, trait, personaGoal, hiddenAgenda, pressureStyle, opening}
  rubric           String            @db.Text // JSON [{key,label,rubric,weight}] — dibuat dari tujuan pengguna
  sourceScenarioId String? // id skenario tetap asal, bila ini hasil "Sesuaikan & Mainkan"
  customized       Boolean           @default(false) // true = turunan skenario tetap yang diubah pengguna
  sessions         PracticeSession[]
  createdAt        DateTime          @default(now())
}

model SessionMessage {
  id        String          @id @default(cuid())
  sessionId String
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | persona
  content   String          @db.Text
  createdAt DateTime        @default(now())
}

model AdaptationEvent {
  id        String          @id @default(cuid())
  sessionId String
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromLevel Int
  toLevel   Int
  signal    String // mis. "dominating" | "struggling" | "steady"
  reason    String          @db.Text
  createdAt DateTime        @default(now())
}

model Evaluation {
  id           String          @id @default(cuid())
  sessionId    String          @unique
  session      PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  verdict      String          @db.Text
  overall      Int
  scores       String // JSON [{key,label,score,weight}]
  quotes       String // JSON string[] — tepat 3 kutipan bukti
  blindSpot    String          @db.Text
  alternative  String          @db.Text
  drill        String          @db.Text
  comparison   String          @default("") @db.Text
  patterns     String          @default("") // pola berbahaya yang terdeteksi, dipisah koma
  recurring    String          @default("") // kelemahan berulang dari memori
  voiceSummary String          @default("") @db.Text // ringkasan suara (hanya bila ada jawaban suara): kecepatan, filler, catatan
  sharpened    String          @default("") @db.Text // JSON {original, sharpened, why} — "Kalimatmu vs Versi yang Lebih Tajam"
  drillStatus  String          @default("") // status latihan 2 menit sebelumnya saat evaluasi dibuat: "selesai" | "belum" | "tidak ada"
  register     String          @default("santai") // formal | santai — register yang dipakai di sesi ini
  toolTrace    String          @default("[]") @db.Text // JSON [{tool,input,output,durationMs}]
  createdAt    DateTime        @default(now())
}

model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche       String   @default("")
  audience    String   @default("")
  values      String   @default("") // maks 3, dipisah koma
  tone        String   @default("")
  credibility String   @default("") @db.Text // bukti: tahun pengalaman, seminar, dsb.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrandAudit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String   @db.Text
  posts     String   @default("") @db.Text
  scores    String // JSON [{key,label,score}]
  rewrite   String   @db.Text // bio baru siap pakai
  toolTrace String   @default("[]") @db.Text
  createdAt DateTime @default(now())
}

model ContentReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft     String   @db.Text
  platform  String   @default("Threads")
  scores    String // JSON [{key,label,score}] — Hook, Kejelasan, Kejujuran
  hooks     String // JSON string[] — tepat 3 hook rewrite
  toolTrace String   @default("[]") @db.Text
  createdAt DateTime @default(now())
}

// --- Rate limiting (DB-backed, tahan di Vercel serverless) ---
// Satu baris per kunci (mis. "login:email@x:1.2.3.4") per jendela waktu.
// Jendela dihitung dari windowStart; baris kedaluwarsa direset, bukan dihapus
// paksa — tidak ada cron pembersih, baris lama ditimpa saat jendela baru.
// Tidak ada relasi ke User: kunci sudah mengandung identitas yang cukup.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Batas pemakaian LLM harian (penghemat biaya OpenAI) ---
// Satu baris per pengguna per hari (yyyy-mm-dd). Dihitung HANYA saat
// panggilan LLM benar-benar berhasil; giliran rule-based tidak dihitung.
model LlmUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // yyyy-mm-dd (WIB)
  turns     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// --- Batas pemakaian TTS harian (penghemat kredit ElevenLabs) ---
// Satu baris per pengguna per hari (yyyy-mm-dd, WIB). Karakter dihitung
// HANYA saat generasi suara cloud benar-benar berhasil.
model TtsUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // yyyy-mm-dd (WIB)
  chars     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// --- Token reset password (sekali pakai, 1 jam) ---
// Token mentah HANYA dikirim lewat email (bila layanan email dipasang) —
// tidak pernah dikembalikan di respons API atau ditulis ke log.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// --- Langganan SaaS (harga SAMA dengan ruang Muse) ---
// Free Rp0 | Pro Rp99.000/bln atau Rp79.200/bln tahunan (Rp950.400/thn)
// Tim/Institusi mulai Rp1.500.000/bln/tim (s.d. 10 anggota). Trial Pro 14 hari.
// Pembayaran: SIMULASI saja — belum ada transaksi nyata / Midtrans live.
model Subscription {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String    @default("free") // free | pro | tim
  status      String    @default("active") // active | trialing | cancelled
  trialEndsAt DateTime?
  renewsAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// --- Umpan balik pengguna (rating + komentar) ---
// Dikirim pengguna setelah sesi (kind "sesi", sessionId terisi) atau tentang
// aplikasi secara umum (kind "aplikasi", sessionId null). Komentar HANYA
// terlihat oleh pemilik aplikasi + pengirimnya sendiri — bukan pengguna lain.
// Tidak ada seed/contoh umpan balik: produksi mulai kosong.
model Feedback {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5, wajib
  comment   String           @default("") @db.Text // opsional, maks 1000 karakter
  kind      String           @default("aplikasi") // "sesi" | "aplikasi"
  sessionId String?
  session   PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
}
